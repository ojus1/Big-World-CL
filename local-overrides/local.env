# Add your OpenAI key here privately, then chmod 600 MiroFish/.env.
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-5.6-luna
LLM_REASONING_EFFORT=low
GRAPH_BACKEND=local
LOCAL_GRAPH_ALLOW_REMOTE_LLM=true
LOCAL_GRAPH_WORKERS=4
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=False
OASIS_DEFAULT_MAX_ROUNDS=10
REPORT_AGENT_MAX_TOOL_CALLS=5
REPORT_AGENT_MAX_REFLECTION_ROUNDS=2
